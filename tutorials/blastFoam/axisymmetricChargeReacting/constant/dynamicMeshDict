FoamFile
{
    format      binary;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    libs            ( "libblastFvMeshTopoChangers.so" );
    type            hexRefiner;

    errorEstimator  densityGradient;
    refineInterval  1;
    lowerRefineLevel 0.05;
    unrefineLevel   0.05;
    nBufferLayers   1;
    maxRefinement   4;
    dumpLevel       true;
}

distributor
{
    libs            ( "libblastFvMeshDistributors.so" );
    type            redistributor;
}


