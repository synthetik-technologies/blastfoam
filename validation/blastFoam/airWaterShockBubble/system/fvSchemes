FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme      HLLC;

ddtSchemes
{
    default         Euler;
    timeIntegrator  RK2SSP;
}

gradSchemes
{
    default         cellMDLimited leastSquares 1;
}

divSchemes
{
    default         none;
    "div\(nHatf,.*\)" Gauss Minmod;
    div(phirb,alpha) Gauss Minmod;
     div(phi,levelSet.air) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;
    reconstruct(alpha)  CICSAM 0.5;// Minmod;
    reconstruct(rho)    Minmod;
    reconstruct(interfaceRho) Minmod 0.5;
    reconstruct(U)      Minmod;
    reconstruct(e)      Minmod;
    reconstruct(p)      Minmod;
    reconstruct(speedOfSound) Minmod;
}

snGradSchemes
{
    default         corrected;
}


