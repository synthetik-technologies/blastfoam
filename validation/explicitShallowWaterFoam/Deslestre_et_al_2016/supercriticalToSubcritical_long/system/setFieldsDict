FoamFile
{
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue h0  0
);

regions
(
    boxToCell
    {
        box (-1 0 0) (2000 10 1);

        fieldValues
        (
            volScalarFieldFunction h0 -setAllBoundaries
            {
                type coded;
                codeInclude
                #{
                    #include "../../../MacDonald.H"
                    scalar S0Eqn::h(const scalar x) const
                    {
                        if (x < 500)
                        {
                            return cbrt(4.0/g_)*(9.0/10.0 - exp(-x/250.0)/6.0);
                        }
                        const scalarList a({-0.348427, 0.552264, -0.55558});
                        scalar S0 = 1.0 + 4.0/5.0*exp(x/1000.0 - 1.0);
                        forAll(a, i)
                        {
                            scalar k = 1.0 + i;
                            S0 += a[i]*exp(-20.0*k*(x/1000.0 - 0.5));
                        }
                        return cbrt(4.0/g_)*S0;
                    }
                    scalar S0Eqn::dhdx(const scalar x) const
                    {
                        if (x < 500)
                        {
                            return cbrt(4.0/g_)*exp(-x/250.0)/1500.0;
                        }
                        const scalarList a({-0.348427, 0.552264, -0.55558});
                        scalar dS0 = 1.0/1250.0*exp(x/1000.0 - 1.0);
                        forAll(a, i)
                        {
                            scalar k = 1.0 + i;
                            dS0 -=
                                a[i]*k/50.0
                               *exp(-20.0*k*(x/1000.0 - 0.5));
                        }
                        return cbrt(4.0/g_)*dS0;
                    }
                #};
                code
                #{
                    static S0Eqn eqn;
                    return eqn.h0(x);
                #};
            }
        );
    }


);

