FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver          ode;
}

chemistry       on;

initialChemicalTimeStep 1e-08;

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-4;
}

// Local chemical equilibrium above Teq; no finite-rate reactions
equilibrium
{
    Teq             2500;
}

reactions
{}

