FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fields (alpha.tnt);
nBufferLayers 5;
refiner directionalRefiner;

defaultFieldValues
(
    volScalarFieldValue alpha.tnt 0
);


regions
(
    sphericalMassToCell // Use cylinder for 3D
    {
        centre (0 0 1.0);
        radius 0.05271;
        mass 1.0;
        rho 1630;
        backup
        {
            centre (0 0 1.0);
            radius 0.1;
        }
        refineInternal no;
        level 0;

        fieldValues
        (
            volScalarFieldValue alpha.tnt    1
        );
    }
);


