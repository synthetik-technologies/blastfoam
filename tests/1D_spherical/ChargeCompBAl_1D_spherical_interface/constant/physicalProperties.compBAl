FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            detonating;
reactants
{
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState Murnaghan;
    }
    equationOfState
    {
        rho0            1624.45;
        n               6.0;
        K0              12.61e9;
        Gamma           1.22;
        pRef            101325;
        pMax            1e11;
    }
    specie
    {
        molWeight       70.21;
    }
    transport
    {
        mu              1e-04;
        Pr              0.7;
    }
    thermodynamics
    {
        Cv              1030;
        Hf              0;
    }
}
products
{
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState eJWLC;
    }
    equationOfState
    {
        // Products-only fit (EuDetCode --jwl-products-only): the 27% inert
        // Al is carried by the Al phase, so the fit excludes it
        rho0            1624.45;
        A               224.943e9;
        B               2.77303e9;
        C               1.47024e9;
        R1              3.456;
        R2              0.813403;
        omega           0.302717;
        pMax            1e11;
        Cv              1450;
        T_CJ            3844.39;
        rho_CJ          2150.55;
        omegaT          0.371065; // T_s through T_CJ and the gas-EOS T at transfer
        E0              -503470.78;
    }
    specie
    {
        molWeight       24.02;
    }
    transport
    {
        mu              1e-04;
        Pr              0.7;
    }
    thermodynamics
    {
        Cv              1450;
        Hf              0;
    }
}
activationModel nodeProgrammed;
initiation
{
    // Detonation energy release; the products E0 is on the gas-phase
    // (JANAF) reference, see ChargeCompBAl_1D_spherical_alCombustion
    e0              5.0174e6;
    points          ( ( 0 0 0 ) );
    delay           1;  // never initiated: stationary unreacted charge
    vDet            7154.23;
    Pcj             2.01512e+10;
    burnModel       programmed;
}
residualRho     1e-06;
residualAlpha   1e-06;

// ************************************************************************* //
