FoamFile
{
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue h0  0
);

regions
(
    boxToCell
    {
        box (-1 0 0) (2000 10 1);

        fieldValues
        (
            volScalarFieldFunction h0 -setAllBoundaries
            {
                type coded;
                codeInclude
                #{
                    #define d2dx2
                    #include "../../../MacDonald.H"

                    scalar S0Eqn::h(const scalar x) const
                    {
                        return
                            cbrt(4.0/g_)
                           *(1.0 - 0.2*exp(-36.0*sqr(x/1000.0 - 0.5)));
                    }
                    scalar S0Eqn::dhdx(const scalar x) const
                    {
                        scalar z = x/1000.0 - 0.5;
                        scalar dzdx = 1.0/1000.0;
                        return
                            cbrt(4.0/g_)
                           *72.0/5.0*exp(-36.0*sqr(z))
                           *z*dzdx;
                    }
                    scalar S0Eqn::d2hdx2(const scalar x) const
                    {
                        scalar z = x/1000.0 - 0.5;
                        scalar dzdx = 1.0/1000.0;
                        return
                            cbrt(4.0/g_)
                           *72.0/5.0*exp(-36*sqr(z))
                           *(1.0 - 72.0*sqr(z))*sqr(dzdx);
                    }
                #};
                code
                #{
                    static S0Eqn eqn;
                    return eqn.h0(x);
                #};
            }
        );
    }


);

