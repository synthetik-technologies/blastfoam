FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseChange
{
    type            pressurePhaseChange;
    sourcePhase     c4;
    targetPhase     gas;
    pThreshold      1e6;
    pRange          1e5;
    tau             1e-4;
    targetFractions
    {
        H2O          1.0;
    }
    isMoleFraction  false;
}

