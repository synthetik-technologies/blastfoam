FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastEulerFoam;

startFrom       latestTime;

startTime       0;

// The run starts from the mapped 1D solution at t0 (Allrun); beginTime 0
// makes it a restart, so the detonation energy already in the mapped
// products is not added again (activationModel::initESource)
beginTime       0;

stopAt          endTime;

endTime         2e-3;

writeControl    adjustableRunTime;

writeInterval   5e-5;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

deltaT          1e-9;

maxCo           0.2;

// ************************************************************************* //

functions
{
    sampleLine
    {
        type            sets;
        libs            (sampling);
        interpolationScheme cell;
        setFormat       raw;
        executeControl  writeTime;
        writeControl    writeTime;
        sets
        (
            line0
            {
                type    lineUniform;
                axis    distance;
                start   (0 1e-06 0);
                end     (2 1e-06 0);
                nPoints 2000;
            }
            line45
            {
                type    lineUniform;
                axis    distance;
                start   (1e-06 1e-06 0);
                end     (1.41421 1.41421 0);
                nPoints 2000;
            }
            line90
            {
                type    lineUniform;
                axis    distance;
                start   (1e-06 0 0);
                end     (1e-06 2 0);
                nPoints 2000;
            }
        );
        fields          (p T.gas U rho alpha.gas alpha.compBAl alpha.Al rho.gas rho.compBAl rho.Al U.gas U.compBAl U.Al);
    }

    pressureProbes
    {
        type           blastProbes;
        writeControl   timeStep;
        writeInterval  1;
        adjustLocations yes;

        // Rays at 0, 45 and 90 degrees from the symmetry plane (radii of
        // the 1D case)
        probeLocations
        (
            (0.01 1e-06 0) // 0 deg, r 0.01
            (0.02 1e-06 0) // 0 deg, r 0.02
            (0.03 1e-06 0) // 0 deg, r 0.03
            (0.04 1e-06 0) // 0 deg, r 0.04
            (0.05 1e-06 0) // 0 deg, r 0.05
            (0.08 1e-06 0) // 0 deg, r 0.08
            (0.1 1e-06 0) // 0 deg, r 0.1
            (0.15 1e-06 0) // 0 deg, r 0.15
            (0.3 1e-06 0) // 0 deg, r 0.3
            (0.5 1e-06 0) // 0 deg, r 0.5
            (1 1e-06 0) // 0 deg, r 1
            (1.5 1e-06 0) // 0 deg, r 1.5
            (1.9 1e-06 0) // 0 deg, r 1.9
            (0.00707107 0.00707107 0) // 45 deg, r 0.01
            (0.0141421 0.0141421 0) // 45 deg, r 0.02
            (0.0212132 0.0212132 0) // 45 deg, r 0.03
            (0.0282843 0.0282843 0) // 45 deg, r 0.04
            (0.0353553 0.0353553 0) // 45 deg, r 0.05
            (0.0565685 0.0565685 0) // 45 deg, r 0.08
            (0.0707107 0.0707107 0) // 45 deg, r 0.1
            (0.106066 0.106066 0) // 45 deg, r 0.15
            (0.212132 0.212132 0) // 45 deg, r 0.3
            (0.353553 0.353553 0) // 45 deg, r 0.5
            (0.707107 0.707107 0) // 45 deg, r 1
            (1.06066 1.06066 0) // 45 deg, r 1.5
            (1.3435 1.3435 0) // 45 deg, r 1.9
            (1e-06 0.01 0) // 90 deg, r 0.01
            (1e-06 0.02 0) // 90 deg, r 0.02
            (1e-06 0.03 0) // 90 deg, r 0.03
            (1e-06 0.04 0) // 90 deg, r 0.04
            (1e-06 0.05 0) // 90 deg, r 0.05
            (1e-06 0.08 0) // 90 deg, r 0.08
            (1e-06 0.1 0) // 90 deg, r 0.1
            (1e-06 0.15 0) // 90 deg, r 0.15
            (1e-06 0.3 0) // 90 deg, r 0.3
            (1e-06 0.5 0) // 90 deg, r 0.5
            (1e-06 1 0) // 90 deg, r 1
            (1e-06 1.5 0) // 90 deg, r 1.5
            (1e-06 1.9 0) // 90 deg, r 1.9
        );
        fields
        (
            p
            alpha.compBAl
            alpha.gas
            alpha.Al
        );
    }

    // Pressure every 15 degrees at r = 0.3, 0.5, 1.0 and 1.5 m
    angularProbes
    {
        type           blastProbes;
        writeControl   timeStep;
        writeInterval  1;
        adjustLocations yes;

        probeLocations
        (
            (0.3 1e-06 0) // 0 deg, r 0.3
            (0.289778 0.0776457 0) // 15 deg, r 0.3
            (0.259808 0.15 0) // 30 deg, r 0.3
            (0.212132 0.212132 0) // 45 deg, r 0.3
            (0.15 0.259808 0) // 60 deg, r 0.3
            (0.0776457 0.289778 0) // 75 deg, r 0.3
            (1e-06 0.3 0) // 90 deg, r 0.3
            (0.5 1e-06 0) // 0 deg, r 0.5
            (0.482963 0.12941 0) // 15 deg, r 0.5
            (0.433013 0.25 0) // 30 deg, r 0.5
            (0.353553 0.353553 0) // 45 deg, r 0.5
            (0.25 0.433013 0) // 60 deg, r 0.5
            (0.12941 0.482963 0) // 75 deg, r 0.5
            (1e-06 0.5 0) // 90 deg, r 0.5
            (1 1e-06 0) // 0 deg, r 1
            (0.965926 0.258819 0) // 15 deg, r 1
            (0.866025 0.5 0) // 30 deg, r 1
            (0.707107 0.707107 0) // 45 deg, r 1
            (0.5 0.866025 0) // 60 deg, r 1
            (0.258819 0.965926 0) // 75 deg, r 1
            (1e-06 1 0) // 90 deg, r 1
            (1.5 1e-06 0) // 0 deg, r 1.5
            (1.44889 0.388229 0) // 15 deg, r 1.5
            (1.29904 0.75 0) // 30 deg, r 1.5
            (1.06066 1.06066 0) // 45 deg, r 1.5
            (0.75 1.29904 0) // 60 deg, r 1.5
            (0.388229 1.44889 0) // 75 deg, r 1.5
            (1e-06 1.5 0) // 90 deg, r 1.5
        );
        fields
        (
            p
        );
    }

    radialPeakPressure
    {
        type            temporalMax;
        libs            ("libblastFunctionObjects.so");
        field           p;
        centre          (0 0 0);
        writeControl    writeTime;
        outputRadial    true;
    }
}
