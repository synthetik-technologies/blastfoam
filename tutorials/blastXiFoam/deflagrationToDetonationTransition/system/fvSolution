FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(U|ea|eau)"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-08;
        relTol          0;
    }
    "(U|ea|eau)Final"
    {
        $U;
        relTol          0;
    }

    "(Su|Xi|b|ft|b)"
    {
        solver          PBiCGStab;
        preconditioner  DIC;
        tolerance       1e-08;
        relTol          0;
    }
    "(Su|Xi|b|ft|b)Final"
    {
        $Su;
    }

    "(k|omega|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0;
    }
    "(k|omega|epsilon)Final"
    {
        $k;
    }
}

PIMPLE
{
    nOuterCorrectors 3;
    nCorrectors     1;
    nNonOrthogonalCorrectors 0;
    outerCorrectorResidualControl
    {
        p
        {
            tolerance   1e-4;
            relTol      0;
        }
    }
}


