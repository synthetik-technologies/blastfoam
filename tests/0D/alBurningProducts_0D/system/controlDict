FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application     blastEulerFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         END_TIME;

libs            ( "libblastFiniteVolume.so" );

writeControl    timeStep;

writeInterval   100000;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

deltaT          DELTA_T;

maxCo           0.5;

functions
{
    mass
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        select          all;
        operation       volIntegrate;
        fields          (alphaRho.Al alphaRho.gas);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }

    state
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        select          all;
        operation       volAverage;
        fields          (d.Al alpha.Al T.Al T.gas p alphaRho.Al alphaRho.gas alphaRhoE.Al alphaRhoE.gas alphaRhoPTE.Al O2.gas N2.gas H2O.gas CO2.gas H2.gas CO.gas "Al2O3(s).gas" "Al2O3(L).gas" ignited.Al);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
}

