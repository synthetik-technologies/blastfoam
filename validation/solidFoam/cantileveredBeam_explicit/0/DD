FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      DD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    wall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    top
    {
        type            solidTraction;
        traction        uniform ( 0 0 0 );
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            solidTraction;
        traction        uniform ( 0 0 0 );
        pressure        uniform 100;
        value           uniform (0 0 0);
    }
    free
    {
        type            solidTraction;
        traction        uniform ( 0 0 0 );
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    tip
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        // tractionSeries
        // {
        //     type table;
        //     values
        //     (
        //         (0 (0 0 0))
        //         (0.1 (0 100 0))
        //     );
        // }
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    empty
    {
        type empty;
    }
}


