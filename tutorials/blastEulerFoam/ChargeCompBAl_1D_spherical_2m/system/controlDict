FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastEulerFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-3;

writeControl    adjustableRunTime;

writeInterval   2e-5;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

deltaT          1e-9;

maxCo           0.2;

// ************************************************************************* //

functions
{
    sampleLine
    {
        type            sets;
        libs            (sampling);
        interpolationScheme cell;
        setFormat       raw;
        executeControl  writeTime;
        writeControl    writeTime;
        sets
        (
            lineX
            {
                type    lineUniform;
                axis    x;
                start   (0 0 0);
                end     (2.0 0 0);
                nPoints 2000;
            }
        );
        fields          (p T.gas U rho alpha.gas alpha.compBAl alpha.Al rho.gas rho.compBAl rho.Al U.gas U.compBAl U.Al);
    }

    pressureProbes
    {
        type           blastProbes;
        writeControl   timeStep;
        writeInterval  1;
        adjustLocations yes;

        probeLocations
        (
            (0.01 0 0)
            (0.02 0 0)
            (0.03 0 0)
            (0.04 0 0)
            (0.05 0 0)
            (0.08 0 0)
            (0.10 0 0)
            (0.15 0 0)
            (0.3 0 0)
            (0.5 0 0)
            (1.0 0 0)
            (1.5 0 0)
            (1.9 0 0)
        );
        fields
        (
            p
            alpha.compBAl
            alpha.gas
            alpha.Al
        );
    }

    radialPeakPressure
    {
        type            temporalMax;
        libs            ("libblastFunctionObjects.so");
        field           p;
        centre          (0 0 0);
        writeControl    writeTime;
        outputRadial    true;
    }
}
