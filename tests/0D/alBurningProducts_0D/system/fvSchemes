FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxSchemes
{
    Al
    {
        fluxScheme  HLLC;
    }
    gas
    {
        fluxScheme  HLLC;
    }
}

ddtSchemes
{
    default         Euler;
    timeIntegrator  RK2SSP;
}

gradSchemes
{
    default         cellMDLimited leastSquares 1.0;
}

divSchemes
{
    default         none;
    div(alphaRhoPhi.gas,Yi)                 Riemann;
    div(phi.Al,d.Al)                        Riemann Al;
    div(alphaRhoPhi.Al,d.Al)                Riemann Al;
    div((((alpha.gas*rho.gas)*nuEff.gas)*dev2(T(grad(U.gas))))) Gauss linear;
    div(sigma.Al)                           Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;
    "reconstruct(.*)"   Minmod;
}

snGradSchemes
{
    default         corrected;
}

wallDist
{
    method          meshWave;
}

