            (1e-06 0.1 0) // 90 deg, r 0.1
            (1e-06 0.15 0) // 90 deg, r 0.15
        );
        fields
        (
            p
            alpha.compBAl
            alpha.gas
            alpha.Al
        );
    }

    // Pressure every 5 degrees at r = 0.10 and 0.15 m
    angularProbes
    {
        type           blastProbes;
        writeControl   timeStep;
        writeInterval  1;
        adjustLocations yes;

        probeLocations
        (
            (0.1 1e-06 0) // 0 deg, r 0.1
