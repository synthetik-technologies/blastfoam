FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme Kurganov;
ddtSchemes
{
    default         backward;
    timeIntegrator  RK2SSP 3;
}

gradSchemes
{
    default         leastSquares;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default         linear;
    reconstruct(h)  quadraticMUSCL limitedCubic 1;
    reconstruct(U)  quadraticMUSCL limitedCubic 1;
}

snGradSchemes
{
    default         corrected;
}


