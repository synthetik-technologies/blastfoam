FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme      HLLC;

ddtSchemes
{
    default         Euler;
    timeIntegrator  RK4SSP;//AdamsBashforth 4;
}

gradSchemes
{
    default         cellMDLimited leastSquares 1.0;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

alphaLim quadraticMUSCL Koren01;
limiter quadraticMUSCL Koren;

interpolationSchemes
{
    default             linear;
    reconstruct(alpha)  $alphaLim;
    reconstruct(rho)    $limiter;
    reconstruct(U)      $limiter;
    reconstruct(e)      $limiter;
    reconstruct(p)      $limiter;
    reconstruct(speedOfSound) $limiter;
}

snGradSchemes
{
    default         corrected;
}


