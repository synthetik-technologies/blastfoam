FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          ( compBAl Al gas );

compBAl
{
    type            detonating;
    reactants
    {
        thermoType
        {
            transport       const;
            thermo          eConst;
            equationOfState Murnaghan;
        }
        equationOfState
        {
            rho0            1624.45;
            n               6.0;
            K0              12.61e9;
            Gamma           1.22;
            pRef            101325;
            pMax            1e11;
        }
        specie
        {
            molWeight       70.21;
        }
        transport
        {
            mu              0;
            Pr              1;
        }
        thermodynamics
        {
            Cv              1030;
            Hf              0;
        }
    }
    products
    {
        thermoType
        {
            transport       const;
            thermo          eConst;
            equationOfState eJWLC;
        }
        equationOfState
        {
            rho0            1624.45;
            A               365.113e9;
            B               2.656e9;
            C               1.043e9;
            R1              3.83395;
            R2              0.8997;
            omega           0.2387;
            pMax            1e11;
            Cv              1450;
            T_CJ            3432.62;
            rho_CJ          2098.7;
            E0              -668384.95;
        }
        specie
        {
            molWeight       38.24;
        }
        transport
        {
            mu              0;
            Pr              1;
        }
        thermodynamics
        {
            Cv              1450;
            Hf              0;
        }
    }
    e0              [0 2 -2 0 0 0 0] 0;
    activationModel linear;
    initiation
    {
        e0              [0 2 -2 0 0 0 0] 0;
        points          ( ( 0.005 0.005 0.005 ) );
        vDet            1e8;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}

Al
{
    // Inert portion of the aluminium (90% of the 30 wt% Al, i.e. 27% of the
    // total charge mass), tracked as a separate condensed phase. The compBAl
    // products JWL is the reactive-products-only fit, so the Al volume is not
    // double counted.
    type            basic;
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState Murnaghan;
    }
    equationOfState
    {
        rho0            2700;
        K0              72.7e9;
        n               4.3;
        Gamma           2.0;
        pRef            101325;
        pMax            1e11;
    }
    specie
    {
        molWeight       26.98;
    }
    transport
    {
        mu              0;
        Pr              1;
    }
    thermodynamics
    {
        Cv              900;
        Hf              0;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}

gas
{
    type            reacting;
    thermoType
    {
        transport       sutherland;
        thermo          janaf;
        equationOfState AbelNobel;
    }
    
    #include "thermo.compressibleGas"
    defaultSpecie   N2;
    
    residualRho     1e-06;
    residualAlpha   1e-06;
}

