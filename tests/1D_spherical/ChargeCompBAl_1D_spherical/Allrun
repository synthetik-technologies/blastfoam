#!/bin/sh
cd ${0%/*} || exit 1    # run from this directory

# Source tutorial run functions
if [ -n "$WM_PROJECT_DIR" ] && [ -f "$WM_PROJECT_DIR/bin/tools/RunFunctions" ]; then
    . $WM_PROJECT_DIR/bin/tools/RunFunctions
fi

# Clean previous time dirs and logs
rm -rf [1-9]* 0.[0-9]* postProcessing log.* constant/polyMesh dynamicCode

# Restore 0 directory fields
for f in 0/*.orig; do
    if [ -f "$f" ]; then
        cp "$f" "0/$(basename "$f" .orig)"
    fi
done

# -- Create paraview file
if command -v paraFoam >/dev/null 2>&1; then
    paraFoam -builtin -touch
else
    touch ChargeCompBAl_1D_spherical.foam
fi

# -- Create base mesh
runApplication blockMesh

# -- Set the charge
runApplication setRefinedFields

# -- Run calculation
runApplication $(getApplication)

# ----------------------------------------------------------------- end-of-file
