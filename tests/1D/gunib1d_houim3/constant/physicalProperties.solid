FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.solid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basic;

thermoType
{
    equationOfState rhoConst;
    thermo          eConst;
    transport       constIso;
}

specie
{
    molWeight       100;
}

equationOfState
{
    rho0            1470.0;
}

transport
{
    kappa           0.36;
}

thermodynamics
{
    type            eConst;
    Cv              718;
    Hf              0;
}

