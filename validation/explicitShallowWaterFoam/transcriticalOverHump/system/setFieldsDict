FoamFile
{
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue h0  0
);

regions
(
    boxToCell
    {
        box (0 0 0) (25 1 1);

        fieldValues
        (
            volScalarFieldFunction h0
            {
                type coded;
                code
                #{
                    return
                        (x > 8.0 && x < 12.0)
                      ? 0.2 - 0.05*sqr(x - 10.0)
                      : 0.0;
                #};
            }
        );
    }


);

