FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver            ode;
    method            standard;
}

chemistry           on;

initialChemicalTimeStep 1e-08;

EulerImplicitCoeffs
{
    cTauChem        1;
}

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-3;
}

#include "reactions.gas"

// ************************************************************************* //
