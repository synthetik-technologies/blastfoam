FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseChange
{
    type            pressurePhaseChange;
    sourcePhase     compBAl;
    targetPhase     gas;
    pThreshold      1e7;
    pRange          1e6;
    tau             1e-4;
    targetFractions
    {
      N2 0.207335;
      CO 0.16837;
      H2O 0.0732687;
      CO2 0.153667;
      NH3 0.00399373;
      CH4 0.0308131;
      C2H6 0.0010903;
      C(gr) 0.0331268;
      // Al(s) 0.27; // To separate phase
	Al2O3(s) 0.0566839;
    }
    isMoleFraction  false;
}

