FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    location        system;
    object          sampleDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type coded;
libs ("libutilityFunctionObjects.so");

codeOptions
#{
    -I$(BLAST_DIR)/src/numerics/lnInclude
#};
codeLibs
#{
    -L$(BLAST_LIBBIN) -lblastNumerics
#};
codeInclude
#{
    #include "volFields.H"
    #include "univariateRootSolver.H"
    #include "stepUnivariateRootSolver.H"
    #include "createEquations.H"

    namespace Foam
    {
    class h1Eqn
    :
        public ScalarEquation
    {
        scalar x_, hl_, hc_, q0_, g_, bM_;

        scalar b(const scalar x) const
        {
            return
                (x > 8 && x < 12)
              ? 0.2 - 0.05*sqr(x - 10.0)
              : 0.0;
        }
        scalar dbdx(const scalar x) const
        {
            return
                (x > 8 && x < 12)
              ? -2.0*0.05*(x - 10.0)
              : 0.0;
        }
    public:

        h1Eqn
        (
            const scalar hl,
            const scalar hc,
            const scalar q0,
            const scalar g
        )
        :
            ScalarEquation(0.1, 0.5),
            hl_(hl),
            hc_(hc),
            q0_(q0),
            g_(g),
            bM_(0.2)
        {}

        scalar& x() { return x_; }
        label nDerivatives() const
        {
            return 1;
        }

        scalar fx(const scalar x, const label li) const
        {
            return
                pow3(x)
              + (b(x_) - sqr(q0_)/(2.0*g_*sqr(hc_)) - hc_ - bM_)*sqr(x)
              + sqr(q0_)/2.0/g_;
        }
        scalar dfdx(const scalar x, const label li) const
        {
            return
                3.0*sqr(x)
              + 2.0*x*(b(x_) - sqr(q0_)/2.0/g_/sqr(hc_) - hc_ - bM_)
              + dbdx(x_)*sqr(x);
        }
    };
    class h2Eqn
    :
        public ScalarEquation
    {
        scalar x_, hl_, hc_, q0_, g_, bM_;

        scalar b(const scalar x) const
        {
            return
                (x > 8 && x < 12)
              ? 0.2 - 0.05*sqr(x - 10.0)
              : 0.0;
        }
        scalar dbdx(const scalar x) const
        {
            return
                (x > 8 && x < 12)
              ? - 2.0*0.05*(x - 10.0)
              : 0.0;
        }
    public:

        h2Eqn
        (
            const scalar hl,
            const scalar hc,
            const scalar q0,
            const scalar g
        )
        :
            ScalarEquation(0.1, 0.5),
            hl_(hl),
            hc_(hc),
            q0_(q0),
            g_(g),
            bM_(0.2)
        {}

        scalar& x() { return x_; }
        label nDerivatives() const
        {
            return 1;
        }

        scalar fx(const scalar x, const label li) const
        {
            return
                pow3(x)
              + (b(x_) - sqr(q0_)/2.0/g_/sqr(hl_) - hl_)*sqr(x)
              + sqr(q0_)/2.0/g_;
        }
        scalar dfdx(const scalar x, const label li) const
        {
            return
                3.0*sqr(x)
              + 2.0*x*(b(x_) - sqr(q0_)/2.0/g_/sqr(hl_) - hl_)
              + dbdx(x_)*sqr(x);
        }
    };
    class xEqn
    :
        public ScalarEquation
    {
        mutable h1Eqn* h1_;
        autoPtr<univariateRootSolver> solver1_;
        mutable h2Eqn* h2_;
        autoPtr<univariateRootSolver> solver2_;
        scalar x_, q0_, g_;
    public:

        xEqn
        (
            h1Eqn& h1,
            h2Eqn& h2,
            const scalar q0,
            const scalar g
        )
        :
            ScalarEquation(10.0, 15.0),
            h1_(&h1),
            solver1_(univariateRootSolver::New("NewtonRaphson", *h1_, dictionary())),
            h2_(&h2),
            solver2_(univariateRootSolver::New("NewtonRaphson", *h2_, dictionary())),
            q0_(q0),
            g_(g)
        {}

        label nDerivatives() const
        {
            return 0;
        }

        scalar fx(const scalar x, const label li) const
        {
            h1_->x() = x;
            h2_->x() = x;
            scalar h1 = solver1_->solve(0.1);
            scalar h2 = solver2_->solve(0.3);
            scalar xS = sqr(q0_)*(1.0/h1 - 1.0/h2) + g_/2.0*(sqr(h1) - sqr(h2));
            return xS;

        }
    };
    class hEqn
    :
        public ScalarEquation
    {
        h1Eqn* h1_;
        h2Eqn* h2_;
        scalar x_, xShock_;
    public:

        hEqn
        (
            h1Eqn& h1,
            h2Eqn& h2,
            const scalar xShock
        )
        :
            ScalarEquation(0.1, 0.5),
            h1_(&h1),
            h2_(&h2),
            xShock_(xShock)
        {}

        void setx(const scalar x) { x_ = x; h1_->x() = x; h2_->x() = x; }
        label nDerivatives() const
        {
            return 1;
        }

        scalar fx(const scalar x, const label li) const
        {
            return
                x_ < xShock_
              ? h1_->fx(x, li)
              : h2_->fx(x, li);
        }
        scalar dfdx(const scalar x, const label li) const
        {
            return
                x_ < xShock_
              ? h1_->dfdx(x, li)
              : h2_->dfdx(x, li);
        }
    };
    }
#};
codeWrite
#{
    const fvMesh& mesh = this->mesh();
    const scalarField x(mesh.cellCentres().component(0));
    volScalarField h
    (
        IOobject
        (
            "h",
            mesh.time().timeName(),
            mesh,
            IOobject::MUST_READ,
            IOobject::NO_WRITE
        ),
        mesh
    );

    const scalar hl = 0.33;
    const scalar q0 = 0.18;
    const scalar g = 9.81;
    const scalar hc = cbrt(sqr(q0)/g);

    h1Eqn h1(hl, hc, q0, g);
    h2Eqn h2(hl, hc, q0, g);
    scalar xShock;
    {
        xEqn eqn(h1, h2, q0, g);
        stepUnivariateRootSolver solver(eqn, dictionary());
        xShock = solver.solve(11.0);

    }
    hEqn eqn(h1, h2, xShock);
    autoPtr<univariateRootSolver> solver
    (
        univariateRootSolver::New("NewtonRaphson", eqn, dictionary())
    );
Info<<xShock<<endl;
    OFstream os("h");
    scalar hi = 0.4;
    forAll(x, i)
    {
        eqn.setx(x[i]);
        hi = solver->solve(hi);
        os  << x[i] << " "
            << hi
            << " " << h[i] << endl;
    }

#};

