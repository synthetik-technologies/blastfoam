FoamFile
{
  version     2.0;
  format      ascii;
  class       dictionary;
  location    "system";
  object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastEulerFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         20e-06;

writeControl    adjustableRunTime;

writeInterval   1e-06;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

deltaT          1e-9;

maxCo           0.2;

// ************************************************************************* //


functions
{
    sampleLine
    {
        type            sets;
        libs            (sampling);
        interpolationScheme cell;
        setFormat       raw;
        executeControl  writeTime;
        writeControl    writeTime;
        sets
        (
            lineX
            {
                type    lineUniform;
                axis    x;
                start   (0 0.005 0.005);
                end     (0.2 0.005 0.005);
                nPoints 1000;
            }
        );
        fields          (p T U rho alpha.gas alpha.compBAl alpha.Al rho.gas rho.compBAl rho.Al H2O.gas O2.gas N2.gas);
    }
}
