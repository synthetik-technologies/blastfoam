FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.compBAl;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Detonation products only (eJWLC): the transfer test starts from the
// fully reacted 100 bar freeze-out state, so no reactants/activation.
type            basic;

thermoType
{
    transport       const;
    thermo          eConst;
    equationOfState eJWLC;
}
equationOfState
{
    rho0            1624.45;
    A               365.113e9;
    B               2.656e9;
    C               1.043e9;
    R1              3.83395;
    R2              0.8997;
    omega           0.2387;
    pMax            1e11;
    Cv              1450;
    T_CJ            3432.62;
    rho_CJ          2098.7;
    omegaT          0.355493; // T_s through T_CJ and the gas-EOS T at transfer
    E0              -668384.95;
}
specie
{
    molWeight       38.24;
}
transport
{
    mu              1e-04;
    Pr              0.7;
}
thermodynamics
{
    Cv              1450;
    Hf              0;
}

residualRho     1e-06;
residualAlpha   1e-06;

// ************************************************************************* //
