FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          ( air bubble );

air
{
    type            basic;
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState perfectGas;
    }
    specie
    {
        molWeight       28.97;
    }
    transport
    {
        mu              1.8e-05;
        Pr              0.7;
    }
    thermodynamics
    {
        Cv              717;
        Hf              0;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}

bubble
{
    type            reacting;
    thermoType
    {
        transport       sutherland;
        thermo          janaf;
        equationOfState perfectGas;
    }
    
    #include "thermo.compressibleGas"
    defaultSpecie   N2;

    residualRho     1e-06;
    residualAlpha   1e-06;
}


