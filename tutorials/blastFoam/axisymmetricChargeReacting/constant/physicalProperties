FoamFile
{
    format      binary;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          ( c4 products );

c4
{
    type            detonating;
    reactants
    {
        thermoType
        {
            transport       const;
            thermo          eConst;
            equationOfState Murnaghan;
        }
        equationOfState
        {
            rho0            1601;
            Gamma           0.35;
            pRef            101298;
            // Unreacted C-4: Reuss mixture of the EuDetCode Murnaghan data of
            // RDX, DOA, PIB and mineral oil (K0 = 1/sum(phi_i/K0_i))
            K0              1.031e+10;
            n               8.14;
        }
        specie
        {
            molWeight       222.12;
        }
        transport
        {
            mu              0;
            Pr              1;
        }
        thermodynamics
        {
            Cv              1000;
            Hf              0;
        }
    }
    products
    {
        thermoType
        {
            transport       const;
            thermo          eConst;
            equationOfState JWL;
        }
        equationOfState
        {
            rho0            1601;
            A               609770000000;
            B               12950000000;
            R1              4.5;
            R2              1.4;
            omega           0.25;
        }
        specie
        {
            molWeight       55;
        }
        transport
        {
            mu              0;
            Pr              1;
        }
        thermodynamics
        {
            Cv              850;
            Hf              0;
        }
    }
    activationModel linear;
    initiation
    {
        E0              9000000000;
        points          ( ( 0 0 0 ) );
        vDet            8217.7; // CJ speed of the products JWL (utilities/thermo_fitter/check_programmed_burn.py)
    }
    residualRho     1e-06;
    residualAlpha   1e-10;
}

products
{
    type            reacting;
    thermoType
    {
    type hePsiThermo;
    mixture multiComponentMixture;
    transport sutherland;
    thermo janaf;
    energy sensibleInternalEnergy;
    equationOfState perfectGas;
    specie specie;
    }
    equationOfState
    {
        gamma           1.4;
        a               0;
    }
    specie
    {
        molWeight       28.97;
    }
    transport
    {
        mu              0;
        Pr              1;
    }
    thermodynamics
    {
        Cv              718;
        Hf              0;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}


