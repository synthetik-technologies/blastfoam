FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            reacting;
thermoType
{
    transport       sutherland;
    thermo          janaf;
    equationOfState AbelNobel;
}

#include "thermo.compressibleGas"
defaultSpecie   N2;

residualRho     1e-06;
residualAlpha   1e-06;

// ************************************************************************* //
