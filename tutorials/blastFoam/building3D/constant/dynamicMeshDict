FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    errorEstimator  densityGradient;
    refineInterval  3;
    lowerRefineLevel 0.1;
    unrefineLevel   0.1;
    nBufferLayers   2;
    maxRefinement   1;
    dumpLevel       true;
    type            hexRefiner;
    libs            1 ( "libblastFvMeshTopoChangers.so" );
}

distributor
{
    errorEstimator  densityGradient;
    refineInterval  3;
    lowerRefineLevel 0.1;
    unrefineLevel   0.1;
    nBufferLayers   2;
    maxRefinement   1;
    dumpLevel       true;
    type            redistributor;
    libs            1 ( "libblastFvMeshDistributors.so" );
}


