FoamFile
{
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue h0  0
    volScalarFieldValue h   0
);


regions
(
    boxToCell
    {
        box (-1 0 0) (2000 10 1);

        fieldValues
        (
            volScalarFieldFunction h0 -setAllBoundaries
            {
                type coded;
                codeInclude
                #{
                    #include "../../S0Eqn.H"
                #};
                code
                #{
                    static S0Eqn eqn;
                    return eqn.h0(x);
                #};
            }
            volScalarFieldFunction h
            {
                type coded;
                codeInclude
                #{
                    #include "../../S0Eqn.H"
                #};
                code
                #{
                    static S0Eqn eqn;
                    static const scalar h0_L = eqn.h0(eqn.L());
                    static const scalar h_L = eqn.h(eqn.L());
                    return max(h_L + h0_L - eqn.h0(x), 0.0);
                #};
            }
        );
    }


);

