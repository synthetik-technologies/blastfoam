FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

R       2.0;
theta   #calc   "Foam::constant::mathematical::pi/180.0";
x       #calc   "$R*cos($theta)*cos($theta)";
y       #calc   "$R*sin($theta)*cos($theta)";
ny      #neg    $y;
z       #calc   "$y";
nz      #calc   "$ny";

vertices
(
    (0 0 0)
    ($x $ny $nz)
    ($x $y  $nz)
    ($x $ny $z)
    ($x $y  $z)
);

blocks
(
    hex (0 1 2 0 0 3 4 0) (799 1 1) simpleGrading (((0.1 200 1) (1.9 599 20)) 1 1)
);

edges
(
);

boundary
(
    wedge0
    {
        type wedge;
        faces
        (
            (0 1 2 0)
        );
    }
    wedge1
    {
        type wedge;
        faces
        (
            (0 3 4 0)
        );
    }
    wedge2
    {
        type wedge;
        faces
        (
            (0 2 4 0)
        );
    }
    wedge3
    {
        type wedge;
        faces
        (
            (0 1 3 0)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 4 3)
        );
    }
);

mergePatchPairs
(
);

