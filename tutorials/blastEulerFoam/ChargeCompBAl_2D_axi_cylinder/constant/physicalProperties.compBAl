FoamFile {
  format ascii;
  class dictionary;
  location "constant";
  object physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type detonating;
reactants {
  thermoType {
    transport const;
    thermo eConst;
    equationOfState Murnaghan;
  }
  equationOfState {
    rho0 1624.45;
    n 6.0;
    K0 12.61e9;
    Gamma 1.22;
    pRef 101325;
    pMax 1e11;
  }
  specie { molWeight 70.21; }
  transport {
    mu 1e-04;
    Pr 0.7;
  }
  thermodynamics {
    Cv 1030;
    Hf 0;
  }
}
products {
  thermoType {
    transport const;
    thermo eConst;
    equationOfState eJWLC;
  }
  equationOfState {
    rho0 1624.45;
    A 224.943e9;
    B 2.77303e9;
    C 1.47024e9;
    R1 3.456;
    R2 0.813403;
    omega 0.302717;
    pMax 1e11;
    Cv 1450;
    T_CJ 3844.39;
    rho_CJ 2150.55;
    omegaT 0.371066; // T_s through T_CJ and the gas-EOS T at transfer
    E0 -507473.38;
  }
  specie { molWeight 24.02; }
  transport {
    mu 1e-04;
    Pr 0.7;
  }
  thermodynamics {
    Cv 1450;
    Hf 0;
  }
}
activationModel nodeProgrammed;
initiation {
  // Detonation energy release (read here; a top-level e0 is ignored).
  // The products E0 is on the gas-phase (nasa9) reference from the 100 bar
  // phase transfer match, so e0 must lift the reactants onto it:
  // e0 = e_s(V_CJ) - Cv_r*T0 - 0.5*p_CJ*(1/rho0 - 1/rho_CJ)
  //    = 6.8274e6 - 0.2966e6 - 1.5174e6 J/kg
  e0 5.0134e6;
  points ((0 0 0));
  vDet 7154.23;
  Pcj 2.01512e+10;
  burnModel programmed;
  // Explosive expanded below half its initial density is fully reacted
  // (traces of reactants carried off the surface by the grazing detonation
  // otherwise reach the temperature cap)
  expansionBurnRatio 0.5;
}
residualRho 1e-06;
residualAlpha 1e-06;

// ************************************************************************* //
