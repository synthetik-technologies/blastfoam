            (0.106066 0.106066 0) // 45 deg, r 0.15
            (0.005 0.00866025 0) // 60 deg, r 0.01
            (0.01 0.0173205 0) // 60 deg, r 0.02
            (0.015 0.0259808 0) // 60 deg, r 0.03
            (0.02 0.034641 0) // 60 deg, r 0.04
            (0.025 0.0433013 0) // 60 deg, r 0.05
