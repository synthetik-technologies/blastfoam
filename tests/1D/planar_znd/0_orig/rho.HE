FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      rho.HE;
}
dimensions      [1 -3 0 0 0 0 0];
internalField   uniform 1717;
boundaryField
{
    left { type zeroGradient; }
    right { type zeroGradient; }
    bottom { type empty; }
    top { type empty; }
    frontAndBack { type empty; }
}
