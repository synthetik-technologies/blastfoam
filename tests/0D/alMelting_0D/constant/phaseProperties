FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          ( Al gas );

transportPhaseDensity true;
VRelaxation     instant;

Al
{
    phaseType       granular;
    diameterModel   constant;
    constantDiameterCoeffs
    {
        d               30e-6;
    }
    alphaMax        0.63;
    alphaMinFriction 0.5;
    kineticTheoryCoeffs
    {
        e               0.999;
    }
    residualAlpha   1e-6;
    residualRho     2700;
}

gas
{
    phaseType       fluid;
    diameterModel   constant;
    constantDiameterCoeffs
    {
        d               0;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}

blending
{
    default
    {
        type            none;
        continuousPhase gas;
    }
}

interfacialPressure
(
    (Al and gas)
    {
        type            single;
        phase           gas;
    }
);

interfacialVelocity
(
    (Al and gas)
    {
        type            single;
        phase           Al;
    }
);

massTransfer
(
);

aspectRatio
(
);

solveDragODE off;

drag
(
    (Al in gas)
    {
        type            GidaspowErgunWenYu;
        residualRe      1e-3;
        swarmCorrection
        {
            type            none;
        }
    }
);

virtualMass
(
);

// Constant coefficient Kh: the heat transfer per unit volume is
// alpha.Al Kh (T.gas - T.Al) [W/m3], which the verifier integrates
// independently
heatTransfer
(
    (Al in gas)
    {
        type            constantCoefficient;
        Kh              1e10;
    }
);

lift
(
);

wallLubrication
(
);

turbulentDispersion
(
);

kineticTheory
{
    alphaMax            0.63;
    residualAlpha       1e-8;
    alphaMinFriction    0.5;
    radialModel         SinclairJackson;
    viscosityModel      none;
    conductivityModel   Syamlal;
    granularPressureModel Lun;
    frictionalStressModel JohnsonJackson;
    JohnsonJacksonCoeffs
    {
        alphaMinFriction        0.5;
        Fr                      0.05;
        eta                     2;
        p                       5;
        phi                     28.5;
        alphaDeltaMin           0.05;
    }
}

pressureRelaxationSolver
{
    type            none;
}

pressureRelaxation
(
);

