FoamFile
{
    format      ascii;
    class       pointVectorField;
    location    "0/fluid";
    object      pointDisplacement.orig;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fixedWalls
    {
        type            fixedNormalSlip;
        n               (0 1 0);
    }
    fluid_to_walls
    {
        type            globalMapped;
        nbrName         pointD;
        value           uniform ( 0 0 0 );
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    defaultFaces
    {
        type            empty;
    }
}


// ************************************************************************* //
