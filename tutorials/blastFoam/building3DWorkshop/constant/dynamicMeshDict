FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    errorEstimator  densityGradient;
    refineInterval  2;
    loadBalance
    {
        balance         yes;
        balanceInterval 10;
        allowableImbalance 0.15;
        method          scotch;
    }
    lowerRefineLevel 0.1;
    unrefineLevel   0.1;
    nBufferLayers   3;
    maxRefinement   2;
    maxCells        10000000;
    dumpLevel       true;
    type            hexRefiner;
    libs            1 ( "libblastFvMeshTopoChangers.so" );
}

distributor
{
    errorEstimator  densityGradient;
    refineInterval  2;
    loadBalance
    {
        balance         yes;
        balanceInterval 10;
        allowableImbalance 0.15;
        method          scotch;
    }
    lowerRefineLevel 0.1;
    unrefineLevel   0.1;
    nBufferLayers   3;
    maxRefinement   2;
    maxCells        10000000;
    dumpLevel       true;
    type            redistributor;
    libs            1 ( "libblastFvMeshDistributors.so" );
}


