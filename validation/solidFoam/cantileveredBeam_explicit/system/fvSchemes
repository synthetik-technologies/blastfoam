FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

d2dt2Schemes
{
    default                 Euler;
}

ddtSchemes
{
    default                 Euler;
}

gradSchemes
{
    default                 extendedLeastSquares 0;
    "limitedGrad\(.*\)"     localLeastSquares 0;
}

divSchemes
{
    default                 none;
    div(sigma)              Gauss linear;
}

laplacianSchemes
{
    default                 Gauss linear corrected;
}

snGradSchemes
{
    default                 corrected;
}

interpolationSchemes
{
    default                 linear;
    reconstruct(P)          linearMUSCL none;
    reconstruct(U)          linearMUSCL none;
}


