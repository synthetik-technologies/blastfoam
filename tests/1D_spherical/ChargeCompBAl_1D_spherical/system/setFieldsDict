FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.compBAl 0
    volScalarFieldValue alpha.Al 0
    volScalarFieldValue alpha.gas 1
    volScalarFieldValue lambda.compBAl 0
);

regions
(
    sphereToCell
    {
        centre (0 0 0);
        radius 0.05;
        fieldValues
        (
            volScalarFieldValue alpha.compBAl 0.7
            volScalarFieldValue alpha.Al 0.3
            volScalarFieldValue alpha.gas 0
            volScalarFieldValue lambda.compBAl 0
        );
    }
);

