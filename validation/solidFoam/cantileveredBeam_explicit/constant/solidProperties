FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel explicitTotalLagrangian;

".*xplicit.*"
{
    dynamicRelaxation yes;
    methods (JST);
    JSTScaleFactor 1e-5;
    relaxationScale 0.95;
    startRelaxation 0.01;
    nRelaxationSteps 10;
}

".*RiemannCoeffs"
{
    angularMomentumConservation yes;
    dynamicRelaxation yes;
    relaxationScale 0.5;
    startRelaxation 0.01;
    nRelaxationSteps 100;
}


