FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 101325;
boundaryField
{
    left { type zeroGradient; }
    right { type zeroGradient; }
    bottom { type empty; }
    top { type empty; }
    frontAndBack { type empty; }
}
