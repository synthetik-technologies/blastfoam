FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



application     blastEulerFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1.5e-3;

libs            ( "libblastFiniteVolume.so" );

writeControl    timeStep;

writeInterval   1000;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

deltaT          1e-7;

maxCo           0.5;

functions
{
    totalEnergy
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        select          all;
        operation       volIntegrate;
        fields          (alphaRhoE.Al alphaRhoE.gas);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }

    temperature
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        select          all;
        operation       volAverage;
        fields          (T.Al T.gas p);
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
}

