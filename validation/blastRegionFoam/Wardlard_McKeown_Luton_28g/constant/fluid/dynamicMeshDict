FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/fluid";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

mover
{
    libs ("libblastFvMotionSolvers.so");
    type motionSolver;

    motionSolver      blastDisplacementLaplacian;
    diffusivity quadratic inverseDistance (fluid_to_walls);
}

