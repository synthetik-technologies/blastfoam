FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh   adaptiveFvMesh;

errorEstimator  multicomponent;
errorEstimators
(
    density
    {
        errorEstimator  densityGradient;
        lowerRefineLevel    0.1;
        unrefineLevel       0.1;
        maxRefinement       2;
    }
    volumeFraction
    {
        errorEstimator      fieldValue;
        field               alpha.air;
        lowerRefineLevel    0.01;
        upperRefineLevel    0.99;

        unrefineLevel       0.001;
        upperUnrefineLevel  0.999;

        maxRefinement       4;
    }
);

// How often to refine
refineInterval  1;

// Have slower than 2:1 refinement
nBufferLayers   1;

// Write the refinement level as a volScalarField
dumpLevel       true;
