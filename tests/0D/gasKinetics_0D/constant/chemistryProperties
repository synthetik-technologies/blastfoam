FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      chemistryProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

chemistryType
{
    solver          ode;
}

chemistry       on;

initialChemicalTimeStep 1e-07;

odeCoeffs
{
    solver          seulex;
    absTol          1e-12;
    relTol          1e-5;
}

// Local chemical equilibrium above Teq; finite-rate gas mechanism below
// (generated by Allrun, utilities/mechanism/make_gas_mechanism.py)
equilibrium
{
    Teq             2500;
}

#include "reactions.gas"

