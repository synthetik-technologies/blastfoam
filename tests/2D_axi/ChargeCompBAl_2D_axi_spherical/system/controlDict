FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastEulerFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         40e-06;

writeControl    adjustableRunTime;

writeInterval   1e-06;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

deltaT          1e-9;

maxCo           0.2;

// ************************************************************************* //

functions
{
    sampleLine
    {
        type            sets;
        libs            (sampling);
        interpolationScheme cell;
        setFormat       raw;
        executeControl  writeTime;
        writeControl    writeTime;
        sets
        (
            line0
            {
                type    lineUniform;
                axis    distance;
                start   (0 1e-06 0);
                end     (0.2 1e-06 0);
                nPoints 400;
            }
            line45
            {
                type    lineUniform;
                axis    distance;
                start   (1e-06 1e-06 0);
                end     (0.141421 0.141421 0);
                nPoints 400;
            }
            line90
            {
                type    lineUniform;
                axis    distance;
                start   (1e-06 0 0);
                end     (1e-06 0.2 0);
                nPoints 400;
            }
        );
        fields          (p T U rho alpha.gas alpha.compBAl alpha.Al rho.gas rho.compBAl rho.Al U.gas U.compBAl U.Al);
    }

    pressureProbes
    {
        type           blastProbes;
        writeControl   timeStep;
        writeInterval  1;
        adjustLocations yes;

        // Rays at 0, 30, 45, 60 and 90 degrees from the symmetry plane
        // (radii as in the 1D case)
