FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      O2.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.24;

boundaryField
{
    left
    {
        type            zeroGradient;
    }

    right
    {
        type            zeroGradient;
    }

    topAndBottom
    {
        type            empty;
    }

    frontAndBack
    {
        type            empty;
    }

    wedge0
    {
        type            empty;
    }

    wedge1
    {
        type            empty;
    }
}

// ************************************************************************* //
