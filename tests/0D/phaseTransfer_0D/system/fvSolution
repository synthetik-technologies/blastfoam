FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(rho|alphaRhoU|alphaRhoE|alpha|d|lambda).*"
    {
        solver          diagonal;
    }

    "(U|e|Yi|Theta|.*\.gas|Ydefault).*"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-09;
        relTol          0;
    }
}


