FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      regionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solutionControls
{
    nOuterCorrectors 1;
    nInitialCorrectors 1;

    predictSolids yes;
    air
    {
        pointD
        {
            tolerance   1e-8;
            relTol      1e-4;

            accelerationScheme IQNILS;
            AitkenCoeffs
            {
                initialRelaxationFactor 1.0;
                maxRelaxationFactor 1;
            }
            fixedCoeffs
            {
                initialRelaxationFactor 0.1;
            }
            IQNILSCoeffs
            {
                initialRelaxationFactor 0.2;
                nCouplingTimes   2;
            }
        }
    }
}

regions
(
    blast       (air)
    solid       (flap)
);


order (flap air a);

interfaces
(
    air
    {
        air_to_flap
        {
            sampleRegion    flap;
            samplePatch     flap_to_air;
            mappingType     AMI;
            interpolationMethod faceAreaWeight;
        }
    }
    flap
    {
        flap_to_air
        {
            sampleRegion    air;
            samplePatch     air_to_flap;
        }
    }
);

