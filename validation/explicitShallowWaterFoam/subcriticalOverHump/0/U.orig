FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U.orig;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (2.21 0 0);

boundaryField
{
    inlet
    {
        type            interstitialInletVelocity;
        alpha           h;
        inletVelocity   $internalField;
        value           $internalField;
    }
    outlet
    {
        type            zeroGradient;
        inletValue      uniform (0 0 0);
        outletValue      uniform (0 0 0);
        value           $internalField;
    }
    frontAndBack
    {
        type            empty;
    }
}


// ************************************************************************* //
