FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          ( air aluminum );

air
{
    type            basic;
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState HaroldAir;
    }
    specie
    {
        molWeight       28.97;
    }
    transport
    {
        mu              0;
        Pr              1;
    }
    thermodynamics
    {
        Cv              0;
        Hf              0;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}

aluminum
{
    type            basic;
    thermoType
    {
        transport       const;
        thermo          eConst;
        equationOfState HaroldAluminum;
    }
    specie
    {
        molWeight       26.98;
    }
    transport
    {
        mu              0;
        Pr              1;
    }
    thermodynamics
    {
        Cv              0;
        Hf              0;
    }
    residualRho     1e-06;
    residualAlpha   1e-06;
}


