FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basic;
thermoType
{
    transport       const;
    thermo          eConst;
    equationOfState idealGas;
}
equationOfState
{
    gamma           1.4;
    a               0;
}
specie
{
    molWeight       28.97;
}
transport
{
    mu              1.81e-05;
    Pr              1;
}
thermodynamics
{
    Cv              718;
    Hf              0;
}
residualRho     1.2;
residualAlpha   1e-06;

// ************************************************************************* //
