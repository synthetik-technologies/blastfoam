FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseType        granular;
diameterModel constant;
constantDiameterCoeffs
{
    d           10e-6;
}
alphaMax    0.63;
alphaMinFriction 0.5;

type basic;
thermoType
{
    equationOfState rhoConst;
    thermo eConst;
    transport constIso;
}
specie
{
    molWeight   100.0;
}
equationOfState
{
    rho0         2500;
}
transport
{
    kappa       0.36;
}
thermodynamics
{
    type        eConst;
    Cv          718;           // Heat capacity
    Hf          0.0;
}

// ************************************************************************* //
