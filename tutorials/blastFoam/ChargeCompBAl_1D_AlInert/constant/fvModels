FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseChange
{
    type            pressurePhaseChange;
    sourcePhase     compBAl;
    targets
    {
        gas
        {
            fraction 0.7;
            targetFractions
            {
                H2O 0.5;
                CO2 0.5;
            }
        }
        Al
        {
            fraction 0.3;
        }
    }
    pThreshold      1e7;
    pRange          1e6;
    tau             1e-4;
    isMoleFraction  false;
    eOffset         5.484e6;
}

