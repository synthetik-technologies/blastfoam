FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type basic;
thermoType
{
    equationOfState rhoConst;
    thermo  eConst;
    transport constIso;
}
specie
{
    molWeight 100;
}
equationOfState
{
    rho0         1470;
}

transport
{
    kappa       1.0;
}
thermodynamics
{
    type        eConst;
    Cv          987;           // Heat capacity
    Hf          0.0;
}

// ************************************************************************* //
