FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastRegionFoam;

regionSolvers
{
    fluid blast;
    walls solid;
}

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         400e-6;

deltaT          1e-8;

writeControl    adjustableRunTime;

writeInterval   1e-6;

cycleWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       1;

// ************************************************************************* //

functions
{
    solidProbes
    {
        type blastProbes;
        region walls;
        fixLocations yes;
        adjustLocations yes;
        append yes;
        probeLocations
        (
            (0.0508 0.115 0)
        );
        fields (D U);
    }
}



