FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseChange
{
    type            pressurePhaseChange;
    sourcePhase     compBAl;
    targetPhase     gas;
    pThreshold      1e7;
    pRange          1e6;
    tau             1e-4;
    targetFractions
    {
        H2          0.00433265;
        N2          0.28739527;
        CO          0.28672579;
        H2O         0.11160467;
        CO2         0.15365548;
        NH3         0.00144386;
        CH4         0.02801544;
        C(gr)       0.04906294;
        Al2O3(s)    0.07776391;
    }
    isMoleFraction  false;
}

// ************************************************************************* //
