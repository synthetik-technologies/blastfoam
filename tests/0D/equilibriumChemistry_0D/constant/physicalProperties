FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            reacting;

thermoType
{
    transport       sutherland;
    thermo          nasa9;
    equationOfState AbelNobel;
}

calculateDensity yes;

species
(
    O2 N2 CO H2O CO2 NH3 CH4 C2H6 Al H2 O N NO H OH AlO "C(gr)" "Al2O3(s)"
);

// Species and NASA-9 data generated by Allrun
// (utilities/thermo_fitter/nasa9_species.py)
#include "thermo.nasa9Gas"

defaultSpecie   N2;

