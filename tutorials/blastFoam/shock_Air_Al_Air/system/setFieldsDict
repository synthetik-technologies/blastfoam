FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.air 1.0
    volScalarFieldValue alpha.aluminum 0
    volScalarFieldValue rho.air 0.0708507
    volScalarFieldValue rho.aluminum 0.102144
    volScalarFieldValue p 1e5
    volScalarFieldValue T 300
    volVectorFieldValue U (0 0 0)
);

regions
(
    // High pressure driver (Air)
    boxToCell
    {
        box (0 -1 -1) (0.2 1 1);
        fieldValues
        (
            volScalarFieldValue p 2e8
            volScalarFieldValue T 70000
            volScalarFieldValue rho.air 0.607278
            volVectorFieldValue U (8000 0 0)
        );
    }

    // Aluminum region
    boxToCell
    {
        box (0.4 -1 -1) (0.6 1 1);
        fieldValues
        (
            volScalarFieldValue alpha.air 0.0
            volScalarFieldValue alpha.aluminum 1.0
            volScalarFieldValue rho.aluminum 0.102144
        );
    }
);

