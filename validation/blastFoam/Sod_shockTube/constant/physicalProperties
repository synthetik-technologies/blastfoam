FoamFile
{
    format      ascii;
    class       dictionary;
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type basic;
thermoType
{
    transport const;
    thermo eConst;
    equationOfState idealGas;
};
equationOfState
{
    gamma       1.4;
}

specie
{
    molWeight    11640.3;
}
transport
{
    mu              0;              // Viscosity
    Pr              1;              // Prandtl number
}
thermodynamics
{
    Cv          1.78575;           // Heat capacity
    Cp          2.5;
    Hf          0.0;
}


