FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            reacting;

thermoType
{
    transport       sutherland;
    thermo          nasa9;
    equationOfState AbelNobel;
}

// Air and Al vapour; NASA-9 data generated by Allrun
// (utilities/thermo_fitter/nasa9_species.py)
species
(
    O2
    N2
    H2O
    CO2
    H2
    CO
    "Al2O3(s)"
    "Al2O3(L)"
);

#include "thermo.nasa9Gas"

defaultSpecie   N2;

residualRho     1e-06;
residualAlpha   1e-06;

// ************************************************************************* //
