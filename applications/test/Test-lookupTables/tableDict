table1D
{
    interpolationScheme linearClamp;
    nX      20;
    minX    1.0;
    maxX    2.0;

    fCoeffs
    {
        file    "table1D.csv";
    }
}

table2D
{
    interpolationScheme linearClamp;
    xCoeffs
    {
        file        "x.csv";
        delim       ";";
        mod         pow10;
        isReal      yes;
    }
    yCoeffs
    {
        file        "y.csv";
        delim       ";";
        mod         exp;
        isReal      yes;
    }
    fCoeffs
    {
        file "table2D.csv";

    }
}

table2D_ls
{
    interpolationScheme linearClamp;
    leastSquaresFit yes;
    xCoeffs
    {
        file        "x.csv";
        delim       ";";
        mod         pow10;
        isReal      yes;
    }
    yCoeffs
    {
        file        "y.csv";
        delim       ";";
        mod         exp;
        isReal      yes;
    }
    leastSquaresCoeffs
    {
        xFile "sparseX.csv";
        yFile "sparseY.csv";
        fFile "sparseF2.csv";
    }
}

table3D
{
    interpolationScheme quadraticClamp;
    xCoeffs
    {
        file        "x.csv";
        delim       ";";
        mod         exp;
        isReal      yes;

    }
    yCoeffs
    {
        file        "y.csv";
        delim       ";";
    }
    zCoeffs
    {
        file        "z.csv";
        mod         pow10;
        isReal      yes;
    }
    fCoeffs
    {
        file        "table3D.csv";
        mod         none;
        delim       ",";
        rowDelim    ";";
        mod         ln;
        isReal      yes;
    }
}

table3D_ls
{
    interpolationScheme quadraticClamp;

    xCoeffs
    {
        file        "x.csv";
        delim       ";";
        mod         exp;
        isReal      yes;

    }
    yCoeffs
    {
        file        "y.csv";
        delim       ";";
    }
    zCoeffs
    {
        file        "z.csv";
        mod         pow10;
        isReal      yes;
    }

    leastSquaresFit yes;
    leastSquaresCoeffs
    {
        xFile "sparseX.csv";
        yFile "sparseY.csv";
        zFile "sparseZ.csv";
        fFile "sparseF3.csv";
    }
}
