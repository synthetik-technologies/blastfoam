#!/bin/sh
cd "${0%/*}" || exit
. "${WM_PROJECT_DIR:?}"/bin/tools/RunFunctions

# Usage: Allrun <d> <p> <T> <U> <alpha> <deltaT> <endTime>
python3 setup_case.py --d "$1" --p "$2" --T "$3" --U "$4" --alpha "$5" \
    --deltaT "$6" --endTime "$7" > log.setup_case 2>&1

runApplication blockMesh
runApplication $(getApplication)
