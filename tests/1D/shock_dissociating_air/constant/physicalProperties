FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            reacting;

thermoType
{
    transport       sutherland;
    thermo          nasa9;
    equationOfState perfectGas;
}

// Air as N2, O2, NO, N, O with NASA-9 data to 20 000 K (generated by Allrun,
// utilities/thermo_fitter/nasa9_species.py); local chemical equilibrium above
// Teq (constant/chemistryProperties)
species         ( N2 O2 NO N O );

calculateDensity yes;

#include "thermo.nasa9Air"

defaultSpecie   N2;

