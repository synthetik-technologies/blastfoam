FoamFile
{
    format      binary;
    class       dictionary;
    location    "constant";
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    type            hexRefiner;
    libs            1 ( "libblastFvMeshTopoChangers.so" );

    errorEstimator  densityGradient;

    refineInterval  1;

    lowerRefineLevel 0.01;

    unrefineLevel   0.01;

    nBufferLayers   1;

    maxRefinement   5;

    dumpLevel       true;
}

distributor
{
    type            redistributor;
    libs            1 ( "libblastFvMeshDistributors.so" );
}


