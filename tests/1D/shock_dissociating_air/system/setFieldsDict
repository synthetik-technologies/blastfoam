FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue p 101325
    volScalarFieldValue T 300
    volScalarFieldValue rho 1.1766
    volVectorFieldValue U (0 0 0)
);

regions
(
    boxToCell
    {
        box (-1 -1 -1) (0.2 1 1);
        fieldValues
        (
            volScalarFieldValue p 1.7e9
            volScalarFieldValue T 7500
            volScalarFieldValue rho 789.772
            volVectorFieldValue U (0 0 0)
        );
    }
);

