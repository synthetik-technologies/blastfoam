FoamFile
{
  version     2.0;
  format      ascii;
  class       dictionary;
  location    "system";
  object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     blastEulerFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-4;

writeControl    adjustableRunTime;

writeInterval   1e-6;

writeFormat     binary;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

deltaT          1e-7;

maxCo           0.5;

