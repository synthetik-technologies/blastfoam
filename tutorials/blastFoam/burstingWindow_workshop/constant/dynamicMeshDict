FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

topoChanger
{
    type list;

    topoChangers
    {
        refinement
        {
            type            hexRefiner;
            errorEstimator  densityGradient;

            // How often to refine
            refineInterval  3;

            // Refine field in between lower..upper
            lowerRefineLevel 0.1;

            // If value < unrefineLevel unrefine
            unrefineLevel   0.1;

            // Have slower than 2:1 refinement
            nBufferLayers   2;

            // Refine cells only up to maxRefinement levels
            maxRefinement   1;

            // Write the refinement level as a volScalarField
            dumpLevel       true;
        }
        burst
        {
            type burst;

            patches
            (
                windows
                {
                    intactMasterPatch windowsIntact_master;
                    intactSlavePatch windowsIntact_slave;
                    burstMasterPatch windowsBurst_master;
                    burstSlavePatch windowsBurst_slave;


                    burstModel      pressure;
                    partialBurst    yes;
                    pBurst          5e6;
                    useDelta        yes;

                    patchToPatch    nearest;
                }
            );
        }
    }
}
