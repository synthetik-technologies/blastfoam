FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phaseChange
{
    type            pressurePhaseTransfer;
    sourcePhase     HE;
    targetPhase     gas;
    pThreshold      1e7;
    pRange          1e6;
    tau             1e-5;
    isMoleFraction  false;
}

