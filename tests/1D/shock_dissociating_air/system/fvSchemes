FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme      HLLC;

ddtSchemes
{
    default         Euler;
    timeIntegrator  RK2SSP;
}

gradSchemes
{
    default         cellMDLimited Gauss linear 1.0;
}

divSchemes
{
    default         none;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(devTau)     Gauss linear;
    div(alphaRhoPhi,Yi) Riemann;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;
    "reconstruct\(.*\)" quadraticMUSCL Minmod;
    interpolate(speedOfSound) linear;
    flux(U) linear;
}

snGradSchemes
{
    default         corrected;
}

