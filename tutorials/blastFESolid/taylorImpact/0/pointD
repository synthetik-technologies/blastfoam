FoamFile
{
    version     2.0;
    format      ascii;
    class       pointVectorField;
    location    "0";
    object      pointD;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    symmetricY
    {
        type            symmetry;
    }

    symmetricZ
    {
        type            symmetry;
    }

    symmetricX
    {
        type            symmetry;
    }

    free
    {
        type            calculated;
    }

    wedge
    {
        type            wedge;
    }
}

