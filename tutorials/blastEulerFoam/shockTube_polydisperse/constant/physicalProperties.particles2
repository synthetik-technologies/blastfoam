FoamFile
{
    format      binary;
    class       dictionary;
    location    "constant";
    object      physicalProperties.particles2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basic;

thermoType
{
    equationOfState rhoConst;
    thermo          eConst;
    transport       constIso;
}

specie
{
    molWeight       100;
}

equationOfState
{
    rho0            2700;
}

transport
{
    kappa           0.36;
}

thermodynamics
{
    type            eConst;
    Cv              987;
    Hf              0;
}

// ************************************************************************* //
