FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      h.orig;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

#include "${FOAM_CASE}/h";
internalField   $h_0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
        value           $h_0;
    }
    outlet
    {
        type            zeroGradient;
        value           $internalField;
    }
    frontAndBack
    {
        type            empty;
    }
}


// ************************************************************************* //
