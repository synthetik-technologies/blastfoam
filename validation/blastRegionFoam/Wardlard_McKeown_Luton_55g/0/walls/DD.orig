FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/walls";
    object      DD.orig;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fixedWalls
    {
        type            fixedDisplacement;
        value           uniform (0 0 0);
    }
    freeWall
    {
        type            solidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        value           uniform (0 0 0);
    }
    walls_to_fluid
    {
        type            coupledSolidTraction;
        traction        uniform (0 0 0);
        pressure        uniform 0;
        pRef            1e5;
        value           uniform (0 0 0);
    }
    wedge
    {
        type            solidWedge;
        patchType       wedge;
        value           $internalField;
    }
}

// ************************************************************************* //
