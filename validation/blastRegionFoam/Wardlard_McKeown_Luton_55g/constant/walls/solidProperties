FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant/walls";
    object      solidProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel nonLinearRiemann;

explicitTotalLagrangianCoeffs
{
    useBulkViscosity yes;
    linearBulkViscosityCoeff 0.6;
    quadraticBulkViscosityCoeff   1.5;

    stabilisation
    {
        // Default: JST, JSTScaleFactor = 1e-3
        // LaplacianScaleFactor = 0.01
        // method JST;
        methods (JST Laplacian);
        JSTScaleFactor          0.001;
        LaplacianScaleFactor    0.1;
    }
}


totalLagrangianCoeffs
{
    // Maximum number of momentum correctors
    nCorrectors             2000;

    // Solution tolerance for displacement
    solutionTolerance       1e-06;

    // Alternative solution tolerance for displacement
    alternativeTolerance    1e-06;

    // Material law solution tolerance
    materialTolerance       1e-06;

    // Write frequency for the residuals
    infoFrequency           100;
}


