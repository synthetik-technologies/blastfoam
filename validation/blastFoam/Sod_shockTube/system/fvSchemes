FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      "fvSchemes";
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

fluxScheme      HLLC;

ddtSchemes
{
    default         Euler;
    timeIntegrator  RK2SSP 4;
}

gradSchemes
{
    default         cellLimited Gauss linear 1.0;
}

divSchemes
{
    default         none;
}

laplacianSchemes
{
    default         Gauss linear corrected;
}

interpolationSchemes
{
    default             linear;

    reconstruct(scalar) Minmod;
    reconstruct(vector) MinmodV;
}

snGradSchemes
{
    default         corrected;
}


