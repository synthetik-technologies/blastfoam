#!/bin/sh
cd ${0%/*} || exit 1    # run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# -- Create paraview file
paraFoam -builtin -touch

# -- Create base mesh
runApplication blockMesh

# -- Set the charge
cp 0/alpha.compBAl.orig 0/alpha.compBAl
cp 0/rho.compBAl.orig 0/rho.compBAl
cp 0/rho.gas.orig 0/rho.gas
cp 0/p.orig 0/p
cp 0/T.orig 0/T
cp 0/U.orig 0/U
cp 0/lambda.compBAl.orig 0/lambda.compBAl
cp 0/N2.gas.orig 0/N2.gas
cp 0/O2.gas.orig 0/O2.gas
cp 0/CO.gas.orig 0/CO.gas
cp 0/H2O.gas.orig 0/H2O.gas
cp 0/CO2.gas.orig 0/CO2.gas
cp 0/NH3.gas.orig 0/NH3.gas
cp 0/CH4.gas.orig 0/CH4.gas
cp 0/C2H6.gas.orig 0/C2H6.gas
cp 0/C\(gr\).gas.orig 0/C\(gr\).gas 2>/dev/null || true
cp 0/Al2O3\(s\).gas.orig 0/Al2O3\(s\).gas 2>/dev/null || true
cp 0/Ydefault.gas.orig 0/Ydefault.gas 2>/dev/null || cp 0/Ydefault.gas 0/Ydefault.gas 2>/dev/null
runApplication setFields

# -- Run calculation
runApplication $(getApplication)

# ----------------------------------------------------------------- end-of-file
