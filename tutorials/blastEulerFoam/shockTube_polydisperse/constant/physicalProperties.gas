FoamFile
{
    format      binary;
    class       dictionary;
    location    "constant";
    object      physicalProperties.gas;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basic;

thermoType
{
    transport       const;
    thermo          eConst;
    equationOfState idealGas;
}

equationOfState
{
    gamma           1.4;
}

specie
{
    molWeight       28.97;
}

transport
{
    mu              1.81e-05;
    Pr              1;
}

thermodynamics
{
    type            eConst;
    Cv              718;
    Hf              0;
}

// ************************************************************************* //
